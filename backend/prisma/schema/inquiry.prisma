// !--- Inquiry table ---! //
model Inquiry {
  id Int @id @default(autoincrement())

  assignedToId Int? @map("assigned_to_id")

  statusDataId Int?        @map("status_data_id")
  statusData   StatusData? @relation(fields: [statusDataId], references: [id])

  priority String? @db.VarChar(50)

  description String?

  dataReceived DateTime? @map("data_received") @db.Date

  sourceDataId Int?        @map("source_data_id")
  sourceData   SourceData? @relation(fields: [sourceDataId], references: [id])

  regional String? @db.VarChar(10)

  groupTele String? @map("group_tele") @db.VarChar(50)

  interactionAt DateTime? @map("interaction_at") @db.Timestamptz()
  callCount Int? @map("call_count")
  eventNames EventName[] @default([]) @map("event_names")
  callLog String? @db.Text @map("call_log")
  recordFile String? @map("record_file")
  compensationStatus CompensationStatus? @map("compensation_status")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  assignedTo Account? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  studentId Int?     @unique @map("student_id")
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  campaignRecipients CampaignRecipient[]


  @@index([createdAt])
  @@index([sourceDataId])
  @@map("inquiry")
}


enum Regional {
  kv1
  kv2
  kv3
  kv4
  kv5
  kv6
}

enum EventName {
  TALKSHOW
  LIVESTREAM
  OPEN_DAY
  COFFEE_TALK
  CAMPUS_TOUR
  WORKSHOP
  ONE_ON_ONE_CONSULTATION
}

enum CompensationStatus {
  REPORTED
  COMPENSATED
}

